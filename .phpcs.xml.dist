<?xml version="1.0"?>
<ruleset name="STG Moyasar Payments">
	<description>WordPress Coding Standards for STG Moyasar Payments.</description>

	<file>.</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="parallel" value="8"/>

	<rule ref="WordPress">
		<!--
			This plugin is PSR-4 autoloaded and namespaced, so files are named
			after their class (Migrator.php) rather than WordPress's
			class-migrator.php convention. The WordPress standard explicitly
			allows this for object-oriented code with an autoloader.
		-->
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="stg-moyasar-payments"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="stg"/>
				<element value="stg_moyasar"/>
				<element value="STG\Moyasar"/>
			</property>
		</properties>
	</rule>

	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="8.1-"/>
	<config name="minimum_wp_version" value="6.8"/>
</ruleset>
